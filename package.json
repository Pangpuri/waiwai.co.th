{
  "name": "waiwai.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/alias-hook.mjs --test \"scripts/test-*.ts\"",
    "check:dark": "node scripts/check-dark.ts",
    "check:i18n": "node scripts/check-i18n.ts",
    "check:content": "node --import ./scripts/alias-hook.mjs scripts/check-content.ts",
    "db:seed": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/seed-home.ts",
    "admin:create": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/admin-create.ts",
    "check:db": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/check-db.ts",
    "db:migrate": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:status": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/migrate.ts --status",
    "check:migrations": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/check-migrations.ts",
    "db:purge": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/purge.ts",
    "db:publish-scheduled": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/publish-scheduled.ts",
    "db:backup": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/backup.ts",
    "check:restore": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/restore-check.ts",
    "maintenance:on": "node --import ./scripts/alias-hook.mjs scripts/maintenance.ts on",
    "maintenance:off": "node --import ./scripts/alias-hook.mjs scripts/maintenance.ts off",
    "maintenance:status": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/maintenance.ts status",
    "check:actions": "node --import ./scripts/alias-hook.mjs scripts/check-actions.ts",
    "products:import": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/import-products.ts",
    "recipes:import": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/import-recipes.ts",
    "news:import": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/import-news.ts",
    "db:push": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/db-push.ts",
    "env:vercel": "node --import ./scripts/alias-hook.mjs scripts/env-vercel.ts",
    "check:deploy": "node --import ./scripts/alias-hook.mjs scripts/check-deploy.ts"
  },
  "dependencies": {
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "22.x"
  }
}
